{
  "expo": {
    "name": "Eyrie",
    "slug": "eyrie",
    "scheme": "eyrie",
    "version": "1.0.2",
    "icon": "./assets/Logos/eyrie-logo.png",
    "splash": {
      "image": "./assets/Logos/eyrie-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7FF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logos/eyrie-final-icon.png",
        "backgroundColor": "#019042"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "READ_MEDIA_IMAGES"
      ],
      "package": "com.sydu.eyrie",
      "versionCode": 3
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Eyrie to access your photos so receipt images can be saved.",
          "savePhotosPermission": "Allow Eyrie to save receipt images to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "94d94149-f973-4cec-bb7a-230a1cda5ca2"
      }
    }
  }
}
